{
  "name": "mirab",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "bun run src/mirab.ts",
    "build": "bun build --compile --minify src/mirab.ts --outfile dist/mirab",
    "test": "bun test",
    "vm:image": "bun run scripts/build-vm-image.ts",
    "typecheck": "tsc --noEmit",
    "types": "rm -rf types && tsc -p tsconfig.types.json",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "ai": "7.0.137",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "inquirer": "^12.9.4",
    "node-pty": "1.2.0-beta.15",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5",
    "rixse": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "description": "Agents in VMs on your own machine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addiscorp/mirab.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./tools": {
      "types": "./types/tools.d.ts",
      "default": "./src/tools.ts"
    },
    "./runner": {
      "types": "./types/runner/index.d.ts",
      "default": "./src/runner/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.e2e.test.ts",
    "types",
    "scripts/firecracker.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
